<?xml version="1.0" encoding="UTF-8"?>
<!--
  LEVEL 2 — making a manifest look that way.

  THIS IS WHERE KRAMERIUS' OWN APPLICATION STOPS. It gathers its own records from its own Solr, fills a
  DocumentBundle, and calls the builder. No SPI to implement, no registry, no adapters, no per-library
  configuration — none of which an application serving its own repository needs.

  Pure: a bundle goes in, a document comes out. Nothing here performs I/O, which is also why every test
  of the manifest rules runs offline.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cz.mzk.iiif</groupId>
    <artifactId>iiif-kramerius-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>iiif-kramerius-build</artifactId>
  <name>IIIF Kramerius Builder</name>
  <description>Pure construction of IIIF v3 documents from gathered Kramerius records</description>
  <dependencies>
    <dependency>
      <groupId>cz.mzk.iiif</groupId>
      <artifactId>iiif-kramerius-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>cz.mzk.iiif</groupId>
      <artifactId>iiif-kramerius-model</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
