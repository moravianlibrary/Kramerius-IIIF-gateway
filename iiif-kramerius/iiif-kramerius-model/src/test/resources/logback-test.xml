<!--
  Test logging. Quiet by default so a failing assertion is the loudest thing on screen.

  The IIIF schema wraps its definitions in custom `types` and `classes` keys, which are not JSON Schema
  keywords, so the validator warns about them on every load. They are resolved through $ref and the
  validation is correct; the warning is noise about someone else's file, so it is turned down here
  rather than worked around.
-->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{25} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.networknt.schema.UnknownKeywordFactory" level="ERROR"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
