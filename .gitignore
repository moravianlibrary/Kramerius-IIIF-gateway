# Java / Maven
target/
*.class
*.war
*.jar

# Config
.env

# Viewer-check output: screenshots and a JSON report, rewritten every run. Deliberately NOT baselines
# — the harness asserts on the DOM precisely so a viewer upgrade cannot fail the check by changing
# pixels, so committing images would create the baseline that design avoids.
tests/viewer/out/

# Editors
.idea/
*.iml
.vscode/

# Written by dev/libraries.py for a registry-free deployment: a snapshot of somebody else's
# data, valid on the day it ran. config/libraries.json is the overlay and IS committed.
config/libraries-snapshot.json

# Python
__pycache__/
*.pyc
