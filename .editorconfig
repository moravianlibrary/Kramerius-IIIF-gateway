# Formatting is owned by tooling, not by hand. This file only tells editors what the tools will do.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# google-java-format uses two spaces and 100 columns. Do not fight it; run `make format`.
[*.java]
indent_size = 2

[*.{xml,yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
