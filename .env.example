# Kramerius IIIF gateway configuration.
#
# Every key is optional and falls back to the default shown. Copy to .env to override.
# Read once at startup into a typed config record — no scattered getenv calls (12-factor).
# Rationale for the non-obvious ones is in docs/DESIGN.md.

# ─── Identity ─────────────────────────────────────────────────────────────────
# Public base URL this gateway is served from. Every "id" in every manifest is built from it, so it
# must match how clients actually reach the service or viewers will follow dead links.
IIIF_BASE_URL=https://iiif.digitalniknihovna.cz

# Public Digital Library front end, used for the "Odkaz do Digitální knihovny" homepage link.
IIIF_DIGITAL_LIBRARY_URL=https://www.digitalniknihovna.cz

# ─── Which libraries to serve ─────────────────────────────────────────────────
# Registry mode: resolve library code -> URL, version and adapter from the shared registry.
IIIF_REGISTRY_URL=https://registr.digitalniknihovna.cz/api/libraries?archived=false

# Local declarations, INSTEAD OF or ON TOP OF the registry — the admin decides which.
# Format: code=url|version[|lang:Name;lang:Name], comma-separated.
#
# With IIIF_REGISTRY_URL also set, this is an OVERLAY: the registry supplies the set of libraries and
# their facts, and each field stated here is applied over it. LEAVE A SEGMENT EMPTY to keep the
# registry's — `mzk=||de:Mährische Landesbibliothek` adds a German name and changes nothing else.
# Without the registry it is the whole configuration, so url and version have to be there.
#
# What the registry cannot express, and so what this is for:
#   - a per-library rate an institution asked for ("rps", file form only)
#   - a name in any language but the institution's own and English — it carries exactly those two
#   - a temporary redirect to a test host, or a library mid-upgrade
#   - serving a library the registry flags dead; declaring it is the operator overruling that
#
# GIVE THE NAME. Without it the only thing to call the institution is its code, so every manifest
# attributes the document to "mzk" rather than to a library — and since a code has no language, it is
# emitted untagged. Kramerius cannot supply the name itself: /client/v7.0/info reports only an acronym.
#IIIF_LIBRARIES=mzk=https://api.kramerius.mzk.cz|7.2.2|cs:Moravská zemská knihovna;en:Moravian Library

# The same, in a file, for more than a handful: one line per library instead of one line for all of
# them, which is what makes fifty of them reviewable in a diff. Overlays the registry the same way.
#
# EVERY FIELD IS OPTIONAL. A complete declaration, for a deployment with no registry:
#
#   {"libraries": {"mzk": {"url": "https://api.kramerius.mzk.cz", "version": "7.2.2.1",
#                          "name": {"cs": "Moravská zemská knihovna", "en": "Moravian Library"}}}}
#
# An overlay, for a deployment that has one — this is the common case:
#
#   {"libraries": {"mzk":  {"rps": 4},
#                  "vkol": {"name": {"de": "Wissenschaftliche Bibliothek Olmütz"}}}}
#
# config/libraries.json ships as an EMPTY OVERLAY, which is the expected state — there is nothing
# local to say until an institution asks for something. It used to hold 38 libraries, each restating
# the url, version and name the registry already had and carrying not one local setting: a second copy
# of somebody else's data, going stale from the moment it was written.
#
# For a deployment that must not reach the registry at all, `scripts/libraries.py --snapshot <path>`
# writes a complete list — url, version and name for every library that answers — which is then the
# whole configuration rather than an overlay on one.
#
# THE VERSION HERE IS A FALLBACK, not an instruction. The version selects the adapter, so it is much
# too important to take second-hand: the gateway asks each instance for its own version at /info and
# prefers that answer, both when resolving a library and on every check sweep. A library that upgrades
# is followed without regenerating anything, and a declaration that disagrees is logged and overruled.
#
# Not because the registry is wrong — asked of all 55 of its libraries, the 47 that answered /info
# reported exactly what the registry said, with zero disagreements. Because the registry is a CACHE of
# this, refreshed on its own schedule, while we are one request from the source. Between a Kramerius
# upgrade and the registry noticing, an instance is read by whatever adapter its old version chose, and
# across the K5/K7 boundary that is no manifest at all rather than a worse one.
#
# The value still matters for an instance that answers no /info: eight do not, though every one of them
# is also unreachable outright, so in practice this is what gets used while a library is down.
#
# Both may be set: IIIF_LIBRARIES entries are applied over the file, so one library can be pointed
# somewhere else — a test host, a library mid-upgrade — without editing a generated file.
#IIIF_LIBRARIES_FILE=/etc/iiif/libraries.json

# How long a resolved registry entry is trusted before being re-fetched.
IIIF_REGISTRY_TTL_MINUTES=360

# How often the background checker re-tests every library. One cheap Solr query each, spaced a second
# apart, so a sweep of 56 libraries is ~50s and never more than one request in flight. It also notices a
# library that has been UPGRADED and drops the resolved one, so the next request rebuilds it on the right
# adapter — nothing else does. 0 turns it off, and then /libraries reports "unchecked".
IIIF_LIBRARY_CHECK_MINUTES=30

# ─── Listeners ────────────────────────────────────────────────────────────────
# Public: manifests, /resolve, /libraries, /health, /version.
IIIF_PORT=8080

# Admin: every PUT and DELETE route. Do NOT publish this port — access control is the deployment's
# job, which is why there is no bearer token. See docs/DESIGN.md.
IIIF_ADMIN_PORT=8081

# ─── Canvas dimensions ────────────────────────────────────────────────────────
# How long a request may wait for a cold document's dimensions before answering with what it has.
# A document predicted to exceed this is handed to the worker and answered immediately as partial.
# 10s covers the p95 document (332 canvases) inline at 10-way concurrency and ~250 ms per info.json.
IIIF_DIMENSION_WAIT_SECONDS=10

# Declared for pages whose real size is not known yet. The legacy gateway used this for every page.
IIIF_FALLBACK_CANVAS_SIZE=1000

# Parallel info.json requests against one image server.
IIIF_IMAGE_INFO_CONCURRENCY=10

# ─── Dimension store (Postgres) ───────────────────────────────────────────────
# Also carries the job queue and the per-library sync state. Required for the gateway to cache
# anything; without it every request re-reads dimensions from the image server.
IIIF_DB_URL=jdbc:postgresql://localhost:5432/iiif
IIIF_DB_USER=iiif
IIIF_DB_PASSWORD=
IIIF_DB_POOL_SIZE=10

# ─── Worker ───────────────────────────────────────────────────────────────────
# How often the sync loop runs per library.
IIIF_SYNC_INTERVAL_MINUTES=60

# Re-scanned on each pass, because `modified` is stamped when a document is built rather than when it
# is committed, so the watermark boundary cannot be trusted exactly.
IIIF_SYNC_OVERLAP_MINUTES=10

# Jobs claimed from the queue per round.
IIIF_WORKER_BATCH=32

# ─── Upstream politeness ──────────────────────────────────────────────────────
# Caps on what this gateway does TO each Kramerius and its image server. Shared by both roles.
# These matter more than the inbound limits: a full library walk is tens of millions of requests.
# In flight at once, per library.
IIIF_UPSTREAM_CONCURRENCY=10

# Made per second, per library. NOT implied by the concurrency cap: 10 concurrent lookups against an
# image server answering in 20 ms is 500 requests a second. A 429 or 503 from the upstream overrides this
# for as long as its Retry-After asks. 0 disables pacing.
#
# This is the DEFAULT, not the only lever. A library declared in IIIF_LIBRARIES_FILE may carry its own
# "rps", which wins — 56 institutions ranging from a national library to a forestry archive do not all
# want the same rate, and after one of them asks you to ease off you should not have to slow the other 55.
# `make libraries` carries an existing rps over rather than regenerating it away. Registry mode has no
# such file and uses this value for every library.
IIIF_UPSTREAM_RPS=20
IIIF_HTTP_CONNECT_TIMEOUT_SECONDS=10
IIIF_HTTP_READ_TIMEOUT_SECONDS=60

# ─── Inbound rate limiting ────────────────────────────────────────────────────
# Per-IP token bucket on the public routes. This protects the gateway from its callers; the upstream
# caps above protect the libraries from the gateway, and neither substitutes for the other.
#
# 0 disables it, like IIIF_UPSTREAM_RPS. That symmetry had to be implemented rather than assumed: a
# rate of 0 used to mean "a bucket that starts full and never refills", so every caller was locked out
# permanently from the hundred-and-first request until a restart.
IIIF_RATE_LIMIT_RPS=20
IIIF_RATE_LIMIT_BURST=100

# ─── Solr ─────────────────────────────────────────────────────────────────────
# Internal cursorMark batch size, never an output cap. 500 covers ~98% of documents in one round trip.
IIIF_SOLR_PAGE_SIZE=500

# Sanity ceiling, an order of magnitude above the largest real document (~3600 items). Exceeding it
# is an error rather than an out-of-memory.
IIIF_MAX_ITEMS=50000

# ─── Manifest cache ───────────────────────────────────────────────────────────
# How long a manifest may be considered current — by a client, by a CDN, and by the gateway's own
# in-memory cache, which never outlives it. 0 disables all three.
IIIF_MANIFEST_TTL_MINUTES=60

# How many rendered manifests to keep in memory. With sizes already warm, rebuilding a 202-page MZK
# monograph still costs 190-520 ms and 272 KB of JSON for a byte-identical answer, so this is worth
# having. Only COMPLETE manifests are cached — one still waiting on the worker carries nominal sizes.
# A byte ceiling applies as well, because the median manifest is ~7 KB but the largest is 3568 canvases.
# 0 disables it.
IIIF_MANIFEST_CACHE_SIZE=500

# ─── Extra languages ──────────────────────────────────────────────────────────
# Directory of per-language JSON files (cs.json, sk.json, …), merged over the bundled cs and en at
# startup. Merging is per key, so correcting one label does not mean copying a whole file. Mount it into
# the container to add a language without rebuilding the image.
#
# UNSET is the normal case and means the bundled languages. SET is a promise that something is there:
# a path that is not a directory, or a file in it that does not parse, stops the gateway. That used to
# be a warning — until it was noticed that an operator who mounts this and gets no Slovak is told
# nothing they will ever see. See docs/DECISIONS.md.
#IIIF_TRANSLATIONS_DIR=/etc/iiif/i18n

# ─── Libraries this deployment will not serve ─────────────────────────────────
# Comma-separated codes, refused whatever the registry says. The registry's `alive` flag is its own
# opinion and says nothing about whether an instance can be served.
#
# `mendelu` (5.3.2) is why this exists: its Solr answers 500 to an image probe and returns no
# nextCursorMark at all, so it has no usable Image API and its dimension sync throws rather than walk.
# scripts/libraries.py already drops it from the generated static list; registry mode reads no such file.
#IIIF_EXCLUDED_LIBRARIES=mendelu

# ─── Model tables ─────────────────────────────────────────────────────────────
# Directory of per-floor model tables (kramerius-50.json, kramerius-70.json), merged over the bundled
# ones model by model — so describing a model a newer Kramerius added is a five-line file, not a copy of
# the whole table. A table that does not parse stops the gateway, as every config mistake here does.
#IIIF_MODELS_DIR=/etc/iiif/models

# ─── Catalogue links ──────────────────────────────────────────────────────────
# Not a key. Catalogue mappings are declared per library in IIIF_LIBRARIES_FILE, beside that
# library's rps and its names, because a catalogue mapping is the same kind of thing: something
# local the shared registry has no field for.
#
#   {"libraries": {"vkol": {"catalogue": {
#       "url": "https://vufind.vkol.cz/Record/{id}",
#       "rules": [{"pattern": "^vkol01-?(\\d{9})$", "prefix": "VKOL01-"}]}}}}
#
# A record url with {id} in it, plus ordered regex rules — each capturing the record number in
# group 1 and mapping to the prefix the catalogue wants in front of it. First match wins; nothing
# matching means no link, because a wrong catalogue link looks to a reader like a record we found.
#
# A mapping that cannot be used stops the gateway, like every mistake in every config file here.
# Leave the block out to say "no catalogue"; a block that is present is one you meant.
#
# Only MZK ships bundled in the jar, because it is the only mapping anyone has verified. Its two
# Aleph bases are why this is rules rather than one prefix: MZK03-000548262 resolves and
# MZK01-000548262 is a 404.
#
# There was an IIIF_CATALOGUES_DIR holding one <code>.json per library. It is gone: two mechanisms
# for one kind of setting is one more than anyone remembers, and only one of them had a schema.

# How long a failed page lookup is believed before being retried. NO failure is permanent: a 403 is about
# the caller (Kramerius grants access by licence, and `onsite` means by IP), a 404 against a page Solr says
# has tiles is an inconsistency rather than a fact, and a timeout is neither. Without expiry, a document
# measured from outside the library network keeps nominal canvas sizes forever.
# In seconds, so a short window can be set to exercise the retry — the default is 24 hours.
IIIF_FAILED_LOOKUP_RETRY_SECONDS=86400
